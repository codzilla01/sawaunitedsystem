APP_ENV=development
# Generate each secret locally, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME
# Fernet key for encrypting TOTP secrets; generate with cryptography. Use a separate production secret.
MFA_ENCRYPTION_KEY=CHANGE_ME
BOOTSTRAP_ADMIN_EMAIL=admin@sawa.local
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME
COOKIE_SECURE=false
SESSION_TTL_HOURS=12
UPLOAD_ROOT=./private_uploads
# Production: real HTTPS origin, no trailing slash; COOKIE_SECURE=true
PUBLIC_ORIGIN=https://sawa.example.com
# Use URL-safe random characters for the DB password (it is embedded in DATABASE_URL).
POSTGRES_PASSWORD=CHANGE_ME
# Local SQLite is the default. Production Compose sets DATABASE_URL to PostgreSQL.

# Vercel: set in the project environment (never commit real credentials).
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@POOLED_HOST/DB?sslmode=require
S3_BUCKET=
S3_REGION=
# Optional for compatible storage; HTTPS only. Leave empty for AWS S3.
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Approved private scanner: authenticated HTTPS POST of raw bytes,
# HTTP 200 JSON {"clean": true} only after a complete malware scan.
DOCUMENT_SCANNER_URL=
DOCUMENT_SCANNER_TOKEN=
