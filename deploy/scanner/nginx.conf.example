# Install on the dedicated scanner host, then replace the domain and certificate paths.
# The upstream binds to host loopback via docker-compose.scanner.yml.
limit_req_zone $binary_remote_addr zone=scanner_rate:10m rate=5r/s;
limit_conn_zone $binary_remote_addr zone=scanner_conn:10m;

upstream sawa_scanner {
    server 127.0.0.1:8081;
}

server {
    listen 443 ssl http2;
    server_name scanner.example.com;

    ssl_certificate /etc/letsencrypt/live/scanner.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/scanner.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 16m;
    client_body_timeout 35s;
    limit_req_status 429;

    location = /scan {
        limit_req zone=scanner_rate burst=10 nodelay;
        limit_conn scanner_conn 10;
        proxy_request_buffering off;
        proxy_pass http://sawa_scanner/scan;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 5s;
        proxy_send_timeout 35s;
        proxy_read_timeout 40s;
        proxy_buffering off;
    }

    location = /healthz {
        proxy_pass http://sawa_scanner/healthz;
        proxy_set_header Host $host;
    }

    location / {
        return 404;
    }
}
